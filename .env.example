# ── Auth & Base de données ─────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/behave_db

# ── Groq API ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_TEXT=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.6-27b
GROQ_MAX_TOKENS=1024
GROQ_MAX_TOKENS_FILE=2048
GROQ_TEMPERATURE=0.2

# ── RAG ────────────────────────────────────────────────────────────────────
RAG_K=4
RAG_MAX_HISTORY_TURNS=10
RAG_MIN_RELEVANCE_SCORE=0.55

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_DB_DIR=/absolute/path/to/data/chroma_db
RETRIEVER_MIN_SCORE=0.0
